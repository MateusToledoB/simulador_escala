{
  "name": "calcula-escala",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd apps/api && python -m uvicorn api:app --reload --port 8000",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "setup:api": "pip install -r apps/api/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
